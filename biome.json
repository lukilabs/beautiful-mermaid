{
	"$schema": "https://biomejs.dev/schemas/2.4.8/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": ["**", "!**/*.html"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"style": {
				"noNonNullAssertion": "off",
				"useConst": "warn",
				"useTemplate": "off"
			},
			"complexity": {
				"noCommaOperator": "off",
				"useArrowFunction": "off",
				"noArguments": "off"
			},
			"suspicious": {
				"noAssignInExpressions": "off",
				"useIterableCallbackReturn": "off",
				"noImplicitAnyLet": "off",
				"noRedeclare": "off"
			},
			"correctness": {
				"noUnusedFunctionParameters": "off",
				"noInnerDeclarations": "off"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
